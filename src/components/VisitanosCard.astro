---
import "./VisitanosCard.css";
import CloudFrontImage from "./CloudFrontImage.astro";

export interface Props {
  href: string;
  title: string;
  img: string;
  icons: string[];
}

const { href, title, img, icons } = Astro.props;
---

<a href={href} class="visitanos-card" data-ga-nav={title}>
  <!-- Background Image -->
  <CloudFrontImage
    baseName={img}
    alt={title}
    class="visitanos-card-bg"
    pictureClass="visitanos-card-picture"
    width="720"
    height="440"
    sizes="(max-width: 640px) 400px, (max-width: 1024px) 800px, 1200px"
  />
  
  <!-- Overlay Gradient -->
  <div class="visitanos-card-overlay"></div>

  <!-- Bottom bar: Title & Feature Icons -->
  <div class="visitanos-card-bottom">
    <h3 class="visitanos-card-title">{title}</h3>
    <div class="visitanos-card-icons">
      {icons.map((icon) => (
        <span class="visitanos-icon-chip">{icon}</span>
      ))}
    </div>
  </div>
</a>
