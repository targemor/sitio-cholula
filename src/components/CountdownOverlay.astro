---
// CountdownOverlay.astro
---

<div
  id="launch-countdown-overlay"
  class="countdown-overlay"
  title="Doble clic para cerrar"
>
  <canvas id="confetti-canvas" class="confetti-canvas"></canvas>
  <div class="countdown-card">
    <img
      src="/home/cholula lo tiene todo_logo.webp"
      alt="San Pedro Cholula Lo Tiene Todo"
      class="countdown-logo"
    />

    <p class="launch-eyebrow">Gran Lanzamiento</p>
    <h2 class="launch-date-text">7 de Agosto</h2>
    <div id="cd-auto-number" class="cd-auto-number" style="display:none;">
      10
    </div>
  </div>
</div>

<style>
  .countdown-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    z-index: 999999;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(248, 246, 243, 0.65);
    backdrop-filter: blur(20px) brightness(0.97);
    -webkit-backdrop-filter: blur(20px) brightness(0.97);
    padding: 1.5rem;
    box-sizing: border-box;
    overflow: hidden;
    cursor: pointer;
    transition:
      opacity 0.55s ease,
      transform 0.55s ease;
  }

  .countdown-overlay.hiding {
    opacity: 0;
    transform: scale(1.02);
    pointer-events: none;
  }

  .confetti-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 1;
  }

  .countdown-card {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 500px;
    padding: 1rem;
    text-align: center;
    animation: cardIn 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
  }

  @keyframes cardIn {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .countdown-logo {
    max-width: 240px;
    width: 75%;
    height: auto;
    margin: 0 auto 2.5rem auto;
    display: block;
    object-fit: contain;
    opacity: 0.92;
  }

  .launch-eyebrow {
    font-family: "Roboto", sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: #9e2a2b;
    margin: 0 0 0.6rem 0;
    opacity: 0.85;
  }

  .launch-date-text {
    font-family: "Roboto", sans-serif;
    font-size: 4.2rem;
    font-weight: 900;
    color: #9e2a2b;
    letter-spacing: -0.01em;
    line-height: 1;
    margin: 0 0 1.4rem 0;
  }

  .cd-auto-number {
    font-family: "Roboto", sans-serif;
    font-size: 5.5rem;
    font-weight: 900;
    color: #9e2a2b;
    line-height: 1;
    margin: 0.6rem 0 0 0;
    animation: cdPop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
  }

  @keyframes cdPop {
    from {
      transform: scale(1.6);
      opacity: 0;
    }
    to {
      transform: scale(1);
      opacity: 1;
    }
  }

  .launch-hint {
    font-family: "Roboto", sans-serif;
    font-size: 0.72rem;
    font-weight: 400;
    color: #aaaaaa;
    letter-spacing: 0.05em;
    margin: 0;
  }

  @media (max-width: 600px) {
    .countdown-logo {
      max-width: 190px;
      margin-bottom: 2rem;
    }
    .launch-date-text {
      font-size: 3rem;
    }
  }
</style>

<script>
  function initLaunchOverlay() {
    const overlay = document.getElementById("launch-countdown-overlay");
    const canvas = document.getElementById(
      "confetti-canvas",
    ) as HTMLCanvasElement | null;
    if (!overlay) return;

    // --- Check URL params ---
    const params = new URLSearchParams(window.location.search);
    const isCountdownMode = params.get("countdown") === "true";

    // --- Check dismissed state ---
    const DISMISSED_KEY = "cholula_launch_dismissed_v2";
    if (!isCountdownMode && localStorage.getItem(DISMISSED_KEY) === "1") {
      overlay.style.display = "none";
      return;
    }

    // --- Confetti engine ---
    function launchConfetti() {
      if (!canvas) return;
      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      canvas.width = window.innerWidth;
      canvas.height = window.innerHeight;

      const COLORS = [
        "#9e2a2b",
        "#c84b2f",
        "#d49e22",
        "#ffffff",
        "#f0c040",
        "#e06030",
        "#3a8c5c",
        "#2060c0",
      ];
      const COUNT = 180;
      const pieces: {
        x: number;
        y: number;
        r: number;
        color: string;
        rot: number;
        vx: number;
        vy: number;
        vrot: number;
        opacity: number;
      }[] = [];

      for (let i = 0; i < COUNT; i++) {
        pieces.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height * 0.4 - canvas.height * 0.2,
          r: Math.random() * 7 + 4,
          color: COLORS[Math.floor(Math.random() * COLORS.length)],
          rot: Math.random() * Math.PI * 2,
          vx: (Math.random() - 0.5) * 4,
          vy: Math.random() * 3 + 2,
          vrot: (Math.random() - 0.5) * 0.15,
          opacity: 1,
        });
      }

      let frame = 0;
      function draw() {
        if (!ctx || !canvas) return;
        ctx.clearRect(0, 0, canvas.width, canvas.height);
        for (const p of pieces) {
          ctx.save();
          ctx.globalAlpha = p.opacity;
          ctx.translate(p.x, p.y);
          ctx.rotate(p.rot);
          ctx.fillStyle = p.color;
          ctx.fillRect(-p.r / 2, -p.r / 2, p.r, p.r * 0.5);
          ctx.restore();
          p.x += p.vx;
          p.y += p.vy;
          p.rot += p.vrot;
          p.vy += 0.07; // gravity
          if (frame > 80) p.opacity -= 0.012;
        }
        frame++;
        if (frame < 200) requestAnimationFrame(draw);
        else ctx.clearRect(0, 0, canvas.width, canvas.height);
      }
      draw();
    }

    // --- Close logic ---
    function closeOverlay() {
      launchConfetti();
      overlay.classList.add("hiding");
      setTimeout(() => {
        overlay.style.display = "none";
        if (!isCountdownMode) {
          localStorage.setItem(DISMISSED_KEY, "1");
        }
      }, 700);
    }

    overlay.addEventListener("dblclick", closeOverlay);

    // --- Auto-countdown (query param ?countdown=true) ---
    if (isCountdownMode) {
      const numEl = document.getElementById("cd-auto-number");
      if (numEl) {
        numEl.style.display = "block";
        let count = 10;
        numEl.textContent = String(count);

        const tick = setInterval(() => {
          count--;
          if (count <= 0) {
            clearInterval(tick);
            closeOverlay();
          } else {
            // Re-trigger pop animation by cloning
            numEl.style.animation = "none";
            void numEl.offsetWidth; // reflow
            numEl.style.animation = "";
            numEl.textContent = String(count);
          }
        }, 1000);
      }
    }
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initLaunchOverlay);
  } else {
    initLaunchOverlay();
  }
  document.addEventListener("astro:page-load", initLaunchOverlay);
</script>
