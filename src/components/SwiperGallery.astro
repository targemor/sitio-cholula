---
import 'swiper/css';
import 'swiper/css/pagination';
import './SwiperGallery.css';

export interface Props {
  id: string;
  items: { img: string; label?: string }[];
  isEvento?: boolean;
  isImperdible?: boolean;
  showCredits?: boolean;
  className?: string;
  altPrefix?: string;
}

const { id, items, isEvento = false, isImperdible = false, showCredits = false, className = '', altPrefix = '' } = Astro.props;
---

<div 
  class={`swiper ${isImperdible ? 'swiper--imperdible swiper--focus-carousel' : ''} ${isEvento ? 'swiper--evento' : ''} ${className}`} 
  id={`swiper-${id}`}
>
  {(isImperdible || isEvento) && (
    <div 
      class="swiper-bg-blur" 
      id={`blur-bg-${id}`}
      style={items[0]?.img ? `background-image: url('${items[0].img}')` : ''}
    ></div>
  )}
  <div class="swiper-wrapper">
    {items.map((item, i) => {
      const altText = item.label
        ? item.label
        : altPrefix
          ? `${altPrefix} — foto ${i + 1}, San Pedro Cholula, Puebla`
          : `Foto ${i + 1} — San Pedro Cholula, Puebla`;
      const fallbackTitle = altPrefix || item.label || 'San Pedro Cholula';

      return (
        <div class={`swiper-slide ${isImperdible ? 'swiper-slide--card' : ''} ${isEvento ? 'swiper-slide--evento' : ''}`} data-img={item.img}>
          {isEvento && (
            <div
              class="swiper-slide-blur-bg"
              style={`background-image: url('${item.img}')`}
            ></div>
          )}
          <!-- Skeleton Shimmer Loader & Fallback -->
          <div class="swiper-slide-placeholder">
            <div class="swiper-skeleton-shimmer"></div>
            <div class="swiper-fallback-content">
              <svg class="swiper-fallback-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                <rect x="3" y="3" width="18" height="18" rx="3" ry="3"></rect>
                <circle cx="8.5" cy="8.5" r="1.5"></circle>
                <path d="M21 15l-5-5L5 21"></path>
              </svg>
              <span class="swiper-fallback-title">{fallbackTitle}</span>
              <span class="swiper-fallback-sub">San Pedro Cholula, Puebla</span>
            </div>
          </div>

          <img
            src={item.img}
            alt={altText}
            class={`swiper-slide-img ${isEvento ? 'swiper-slide-img--evento' : ''} ${isImperdible ? 'swiper-slide-img--imperdible' : ''}`}
            loading={i === 0 ? "eager" : "lazy"}
            onload="this.classList.add('is-loaded'); this.closest('.swiper-slide')?.classList.add('slide-loaded');"
            onerror="this.classList.add('has-error'); this.closest('.swiper-slide')?.classList.add('slide-error');"
          />
          {item.label && !isImperdible && <p class="swiper-slide-label">{item.label}</p>}
          {showCredits && (
            <div class="swiper-photo-credit">
              Foto: {
                item.img.toLowerCase().includes("anabeli") ? (
                  <span>Anabeli Arredondo</span>
                ) : (
                  <a
                    href="https://www.instagram.com/mickysantana_art_photography"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="swiper-credit-link"
                  >
                    Mike Santana
                  </a>
                )
              }
            </div>
          )}
        </div>
      );
    })}
  </div>
  <!-- Pagination -->
  <div class="swiper-pagination"></div>
  <!-- Navigation -->
  <div class="swiper-button-prev"></div>
  <div class="swiper-button-next"></div>
</div>


<script>
  import Swiper from 'swiper';
  import { Navigation, Pagination, Autoplay } from 'swiper/modules';

  document.addEventListener('DOMContentLoaded', () => {
    // Inicializar estado de las imágenes (skeleton loader & cached check)
    const initImageStates = () => {
      const allSlideImgs = document.querySelectorAll('.swiper-slide-img');
      allSlideImgs.forEach((imgEl) => {
        const img = imgEl as HTMLImageElement;
        const parent = img.closest('.swiper-slide');

        function markLoaded() {
          img.classList.add('is-loaded');
          if (parent) parent.classList.add('slide-loaded');
        }

        function markError() {
          img.classList.add('has-error');
          if (parent) parent.classList.add('slide-error');
        }

        if (img.complete) {
          if (img.naturalWidth !== 0) {
            markLoaded();
          } else {
            markError();
          }
        } else {
          img.addEventListener('load', markLoaded, { once: true });
          img.addEventListener('error', markError, { once: true });
        }
      });
    };

    initImageStates();
    // Focus carousel para imperdibles
    const focusSwipers = document.querySelectorAll('.swiper--focus-carousel');
    focusSwipers.forEach((el) => {
      const htmlEl = el as HTMLElement;
      const blurEl = htmlEl.querySelector('.swiper-bg-blur') as HTMLElement | null;

      function setBlur(img: string) {
        if (!blurEl || !img) return;
        blurEl.style.backgroundImage = `url('${img}')`;
      }

      const swiper = new Swiper(htmlEl, {
        modules: [Pagination, Autoplay],
        slidesPerView: 1,
        centeredSlides: true,
        spaceBetween: 20,
        loop: true,
        pagination: {
          el: htmlEl.querySelector('.swiper-pagination') as HTMLElement,
          clickable: true,
        },
        autoplay: {
          delay: 3500,
          disableOnInteraction: false,
        },
        breakpoints: {
          640: { slidesPerView: 1.15, spaceBetween: 24 },
          1024: { slidesPerView: 1.25, spaceBetween: 28 },
          1400: { slidesPerView: 1.4, spaceBetween: 32 },
        },
      });

      swiper.on('slideChange', () => {
        const origSlides = Array.from(
          htmlEl.querySelectorAll('.swiper-slide:not(.swiper-slide-duplicate)')
        ) as HTMLElement[];
        const images = origSlides.map(s => s.getAttribute('data-img') || '').filter(Boolean);
        const img = images[swiper.realIndex] || images[0] || '';
        setBlur(img);
      });
    });

    // Carruseles normales (eventos, etc.)
    const regularSwipers = document.querySelectorAll('.swiper:not(.swiper--focus-carousel)');
    regularSwipers.forEach((el) => {
      const htmlEl = el as HTMLElement;
      const blurEl = htmlEl.querySelector('.swiper-bg-blur') as HTMLElement | null;

      function setBlur(img: string) {
        if (!blurEl || !img) return;
        blurEl.style.backgroundImage = `url('${img}')`;
      }

      const swiper = new Swiper(htmlEl, {
        modules: [Navigation, Pagination, Autoplay],
        slidesPerView: 1,
        spaceBetween: 20,
        navigation: {
          nextEl: htmlEl.querySelector('.swiper-button-next') as HTMLElement,
          prevEl: htmlEl.querySelector('.swiper-button-prev') as HTMLElement,
        },
        pagination: {
          el: htmlEl.querySelector('.swiper-pagination') as HTMLElement,
          clickable: true,
        },
        autoplay: {
          delay: 4000,
          disableOnInteraction: false,
        },
        loop: true,
      });

      swiper.on('slideChange', () => {
        const origSlides = Array.from(
          htmlEl.querySelectorAll('.swiper-slide:not(.swiper-slide-duplicate)')
        ) as HTMLElement[];
        const images = origSlides.map(s => s.getAttribute('data-img') || '').filter(Boolean);
        const img = images[swiper.realIndex] || images[0] || '';
        setBlur(img);
      });
    });
  });
</script>
