---
import Layout from "../layouts/Layout.astro";
import BusinessCard from "../components/BusinessCard.astro";
import CategoryFilter from "../components/CategoryFilter.astro";
import QueHacerFilter from "../components/QueHacerFilter.astro";
import HotelFilter from "../components/HotelFilter.astro";
import { DEFAULT_LOCALE, LOCALES, type Locale } from "../i18n/config";
import { isImplemented, localizePath, localizePathSafe } from "../i18n/routes";
import {
  DIRECTORIES,
  DIRECTORY_KEYS,
  type DirectoryKey,
} from "../lib/directories";
import { getBusinesses } from "../lib/business-data";
import "../styles/slug.css";

/**
 * Páginas de directorio (hoteles, restaurantes, qué hacer, guías).
 *
 * Es una ruta `[...slug]` y no `[slug]` porque los idiomas con prefijo ocupan dos
 * segmentos: `/en/where-to-eat`. Así ambos idiomas se sirven desde un solo archivo,
 * sin duplicar el markup.
 */

interface Copy {
  kicker?: string;
  title: string;
  seoTitle: string;
  seoDesc: string;
  description?: string;
}

/**
 * Textos por idioma para páginas de directorio.
 */
const COPY: Record<Locale, Partial<Record<DirectoryKey, Copy>>> = {
  es: {
    lodging: {
      kicker: "TU ESTANCIA",
      title: "¿Dónde hospedarte?",
      seoTitle: "Hoteles en Cholula, Puebla — Dónde Hospedarse",
      seoDesc:
        "Los mejores hoteles en San Pedro Cholula, Puebla. Encuentra alojamiento cerca de la Gran Pirámide, el centro histórico y la zona universitaria. Hoteles boutique, económicos y con todas las comodidades.",
    },
    food: {
      kicker: "SABORES DE CHOLULA",
      title: "¿Dónde comer?",
      seoTitle: "Restaurantes en Cholula, Puebla — Dónde Comer",
      seoDesc:
        "Descubre los mejores restaurantes, bares y cafés en San Pedro Cholula, Puebla. Gastronomía mexicana, cocina internacional, opciones vegetarianas y experiencias culinarias únicas en el corazón del Pueblo Mágico.",
    },
    things: {
      kicker: "EXPERIENCIAS Y ACTIVIDADES",
      title: "¿Qué hacer en Cholula?",
      seoTitle: "Qué Hacer en Cholula, Puebla — Actividades y Atracciones",
      seoDesc:
        "Descubre qué hacer en San Pedro Cholula: visita la Gran Pirámide, el Santuario de la Virgen de los Remedios, el Convento de San Gabriel y mucho más. Actividades culturales, turísticas y de aventura en Cholula, Puebla.",
    },
    guides: {
      kicker: "VIVE CHOLULA CON UN EXPERTO",
      title: "Guías turísticos",
      seoTitle: "Guías Turísticos Certificados en Cholula, Puebla",
      seoDesc:
        "Guías turísticos certificados por SECTUR en San Pedro Cholula. Tours personalizados por la Gran Pirámide, iglesias coloniales, mercados y el centro histórico. Conoce Cholula con expertos locales.",
      description:
        "GUÍAS CERTIFICADOS POR SECTUR — Descubre Cholula de una manera más personalizada junto a guías certificados que adaptan la experiencia a tus intereses y te ayudan a comprender la historia, tradiciones y patrimonio de la ciudad más allá de una visita convencional.",
    },
  },
  en: {
    lodging: {
      kicker: "YOUR STAY",
      title: "Where to stay?",
      seoTitle: "Hotels in Cholula, Puebla — Where to Stay",
      seoDesc:
        "The best hotels in San Pedro Cholula, Puebla. Find accommodation near the Great Pyramid, downtown, and the university district. Boutique, budget, and luxury hotels.",
    },
    food: {
      kicker: "FLAVORS OF CHOLULA",
      title: "Where to eat?",
      seoTitle: "Restaurants in Cholula, Puebla — Where to Eat",
      seoDesc:
        "Discover the best restaurants, bars, and cafes in San Pedro Cholula, Puebla. Mexican gastronomy, international cuisine, vegetarian options, and unique dining experiences.",
    },
    things: {
      kicker: "EXPERIENCES & ACTIVITIES",
      title: "What to do in Cholula?",
      seoTitle: "Things to Do in Cholula, Puebla — Activities & Attractions",
      seoDesc:
        "Discover what to do in San Pedro Cholula: visit the Great Pyramid, the Sanctuary of Remedies, San Gabriel Convent, and more. Cultural, tourist, and adventure activities.",
    },
    guides: {
      kicker: "EXPERIENCE CHOLULA WITH AN EXPERT",
      title: "Tour guides",
      seoTitle: "Certified Tour Guides in Cholula, Puebla",
      seoDesc:
        "SECTUR-certified tour guides in San Pedro Cholula. Personalized tours of the Great Pyramid, colonial churches, traditional markets, and historic downtown.",
      description:
        "SECTUR CERTIFIED GUIDES — Discover Cholula in a more personalized way with certified guides who tailor the experience to your interests.",
    },
  },
};

/** "Inicio" del breadcrumb. Se mueve a src/i18n/ui.ts en la Fase 2. */
const HOME_LABEL: Record<Locale, string> = { es: "Inicio", en: "Home" };

export async function getStaticPaths() {
  return LOCALES.flatMap((locale) =>
    DIRECTORY_KEYS.filter((key) => isImplemented(key, locale)).map((key) => ({
      // localizePath devuelve "/donde-comer" o "/en/where-to-eat";
      // el parámetro va sin la barra inicial.
      params: { slug: localizePath(key, locale).slice(1) },
      props: { key, locale },
    })),
  );
}

const { key, locale } = Astro.props as { key: DirectoryKey; locale: Locale };

const { color, section, schema } = DIRECTORIES[key];
const data = getBusinesses(section, locale);
const copy = (COPY[locale][key] ?? COPY[DEFAULT_LOCALE][key]) as Copy;
const { title, seoTitle, seoDesc, description } = copy;

const path = localizePath(key, locale);

// Por clave de ruta, no por título: el título es texto visible y se traduce.
const isRestaurantes = key === "food";
const isQueHacer = key === "things";
const isHospedaje = key === "lodging";
const clasificaciones = isRestaurantes
  ? (Array.from(
      new Set(data.map((item: any) => item.clasificacion).filter(Boolean)),
    ) as string[])
  : [];

const FALLBACK_IMG =
  "https://images.unsplash.com/photo-1605335191599-4458d98e1690?ixlib=rb-4.0.3&auto=format&fit=crop&w=800&q=80";

// ── JSON-LD ItemList ──────────────────────────────────────────────────────────
const SITE_URL = "https://visitcholula.mx";
const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": seoTitle,
  "description": seoDesc,
  "url": `${SITE_URL}${path}`,
  "numberOfItems": data.length,
  "itemListElement": (data as any[]).map((item, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "item": {
      "@type": schema,
      "name": item.nombre,
      "description": item.descripcion ?? undefined,
      "address": item.direccion ? {
        "@type": "PostalAddress",
        "streetAddress": item.direccion,
        "addressLocality": "San Pedro Cholula",
        "addressRegion": "Puebla",
        "addressCountry": "MX",
      } : undefined,
      "telephone": item.telefono ?? item.whatsapp ?? undefined,
      "url": item.sitioWeb ?? undefined,
      "image": item.galeria?.[0]
        ? (item.galeria[0].startsWith('http') ? item.galeria[0] : `${SITE_URL}${item.galeria[0]}`)
        : undefined,
      "geo": item.googleMaps ? {
        "@type": "GeoCoordinates",
        "latitude": 19.0547,
        "longitude": -98.3018,
      } : undefined,
    },
  })),
};

// ── BreadcrumbList ────────────────────────────────────────────────────────────
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": HOME_LABEL[locale], "item": `${SITE_URL}${localizePathSafe("home", locale)}` },
    { "@type": "ListItem", "position": 2, "name": seoTitle, "item": `${SITE_URL}${path}` },
  ],
};
---

<Layout
  title={seoTitle}
  description={seoDesc}
  canonical={path}
  jsonLd={[itemListSchema, breadcrumbSchema]}
>
  <!-- Hero -->
  <section class="hero" id="hero">
    <video
      class="hero-video"
      poster="/hero-poster.webp"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <source data-src="/video.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay" aria-hidden="true"></div>
  </section>

  <!-- Sección con header fijo + grid scrolleable -->
  <section class="section-categoria">
    <div class="section-inner">
      <!-- Header fijo: título + divider + filtro -->
      <div class="section-header">
        {copy.kicker && (
          <span class="section-kicker">
            {copy.kicker}
          </span>
        )}
        <h2 class="section-label" style={`--section-color: ${color};`}>
          {title}
        </h2>
        {description && <p class="section-description">{description}</p>}
        {
          isRestaurantes && (
            <div class="filter-container">
              <CategoryFilter data={data} />
            </div>
          )
        }
        {
          isQueHacer && (
            <div class="filter-container">
              <QueHacerFilter data={data} />
            </div>
          )
        }
        {
          isHospedaje && (
            <div class="filter-container">
              <HotelFilter data={data} />
            </div>
          )
        }
      </div>

      <!-- Área scrolleable con las tarjetas -->
      <div class="grid-scroll-area">
        <div class="business-grid">
          {
            data.map((item: any, index: number) => (
              <BusinessCard
                id={`item-${index}`}
                title={item.nombre}
                images={
                  item.galeria && item.galeria.length > 0
                    ? item.galeria
                    : [FALLBACK_IMG]
                }
                address={item.direccion || undefined}
                mapsUrl={item.googleMaps || undefined}
                phone={item.telefono || undefined}
                whatsapp={item.whatsapp || undefined}
                sitioWeb={item.sitioWeb || undefined}
                telefonoAlt={item.telefonoAlt || undefined}
                tipoTelefono={item.tipoTelefono || undefined}
                instagram={item.social?.instagram || undefined}
                facebook={item.social?.facebook || undefined}
                tiktok={item.social?.tiktok || undefined}
                description={item.descripcion || undefined}
                clasificacion={item.clasificacion || item.categoria || item.tipo || undefined}
                acreditacion={key === "guides" ? (item.clasificacion || undefined) : undefined}
                especializacion={item.especializacion || undefined}
                idiomas={item.idiomas || undefined}
                toursQueOfrece={item.toursQueOfrece || undefined}
                zona={item.zona || item.dondeEsta || undefined}
                distanciaGranPiramide={item.distanciaGranPiramide || undefined}
                categoriaPrecio={item.categoriaPrecio || undefined}
                aceptaMascotas={item.aceptaMascotas}
                tieneAlberca={item.tieneAlberca}
                tieneSpa={item.tieneSpa}
                terraza={item.terraza}
                recepcion24h={item.recepcion24h}
                amenidades={item.amenidades || undefined}
                tipoComida={item.tipoComida || undefined}
                petFriendly={item.petFriendly}
                musicaEnVivo={item.musicaEnVivo}
                precioPpMxn={item.precioPpMxn || undefined}
                espacioFisico={item.espacioFisico || undefined}
                categoriaGrupo={item.categoriaGrupo || undefined}
                estrellaMichelin={item.estrellaMichelin || false}
              />
            ))
          }
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {
    const params = new URLSearchParams(window.location.search);
    const searchId = params.get("id");
    const hash = window.location.hash;

    let targetCard: HTMLElement | null = null;

    if (searchId !== null) {
      targetCard = document.getElementById(`item-${searchId}`);
    } else if (hash && hash.startsWith("#item-")) {
      targetCard = document.getElementById(hash.substring(1));
    }

    if (targetCard) {
      // Esperamos a que el Swiper/imágenes terminen de renderizar
      setTimeout(() => {
        // .grid-scroll-area NO es un contenedor scrolleable (sin overflow).
        // El scroll real ocurre en el window.
        const stickyHeader = document.querySelector(".section-header");
        const stickyTop = 120; // valor CSS: top: 120px en desktop
        const headerHeight = stickyHeader
          ? stickyHeader.getBoundingClientRect().height
          : 0;
        const clearance = stickyTop + headerHeight + 24; // margen de seguridad

        // Posición absoluta del card en el documento
        const cardDocTop =
          targetCard.getBoundingClientRect().top + window.scrollY;
        window.scrollTo({ top: cardDocTop - clearance, behavior: "smooth" });

        // Highlight visual de la tarjeta seleccionada
        targetCard.style.transition =
          "box-shadow 0.5s ease-in-out, transform 0.5s ease";
        targetCard.style.boxShadow = "0 0 0 6px var(--color-mex-rosa, #e10098)";
        targetCard.style.transform = "scale(1.02)";

        setTimeout(() => {
          targetCard.style.boxShadow = "";
          targetCard.style.transform = "";
        }, 2500);
      }, 500);
    }
  });
</script>
