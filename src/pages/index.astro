---
import Layout from "../layouts/Layout.astro";
import SearchBar from "../components/SearchBar";
import SwiperGallery from "../components/SwiperGallery.astro";
import ImperdiblesCarousel from "../components/ImperdiblesCarousel.astro";
import ImageCard from "../components/ImageCard.astro";
import VisitanosCard from "../components/VisitanosCard.astro";
import ItinerarioTabs from "../components/ItinerarioTabs.astro";
import itinerarioData from "../data/itinerario.json";
import "../styles/index.css";

// Lugares imperdibles
const imperdibles = [
  {
    img: "/home/imperdibles/CERRO-ZAPOTECAS.webp",
    nombre: "Cerro Zapotecas",
    descripcion: "¿Sabías que Cholula tiene su propio bosque? El Cerro Zapotecas es el único, y es el escondite favorito de ciclistas y corredores para perderse entre pinos con vistas que nadie espera encontrar a minutos del centro.",
    categoria: "Naturaleza",
    categoryEmoji: "🌲",
    mapUrl: "https://maps.app.goo.gl/8Q1bA5KYb3WZyMi26",
    highlights: ["bosque", "ciclistas y corredores", "vistas que nadie espera"],
  },
  {
    img: "/home/imperdibles/CONVENTO-DE-SAN-GABRIEL.webp",
    nombre: "Convento de San Gabriel y Capilla Real",
    descripcion: "Estás pisando el mismo lugar donde alguna vez se rindió culto a Quetzalcóatl. Hoy, sobre esas ruinas, se alza una capilla con 9 naves y 48 cúpulas inspiradas en una mezquita — la que más cúpulas tiene en TODO México.",
    categoria: "Templo",
    categoryEmoji: "⛪",
    mapUrl: "https://maps.app.goo.gl/8vPuJBFNiYY7BFQZ7",
    highlights: ["Quetzalcóatl", "9 naves y 48 cúpulas", "más cúpulas tiene en TODO México"],
  },
  {
    img: "/home/imperdibles/COSME-DEL-RAZO.webp",
    nombre: "Mercado Municipal Cosme del Razo",
    descripcion: "El centro de abasto más grande de la región — orejas de elefante, cacao tradicional y sabores de temporada. Es el lugar donde los cholultecas de verdad hacen su compra diaria, lejos del circuito más turístico.",
    categoria: "Mercado",
    categoryEmoji: "🛒",
    mapUrl: "https://maps.app.goo.gl/qbM2UjBPHYMt9cEm8",
    highlights: ["orejas de elefante", "cacao tradicional", "cholultecas de verdad"],
  },
  {
    img: "/home/imperdibles/IGLESIA-DE-SANTA-MARIA-XIXITLA.webp",
    nombre: "Iglesia de Santa María Xixitla",
    descripcion: "A un lado del circuito turístico, este templo del siglo XVI esconde altares completamente bañados en oro. La mayoría de los turistas nunca lo pisa — tú sí puedes.",
    categoria: "Templo",
    categoryEmoji: "⛪",
    mapUrl: "https://maps.app.goo.gl/dZqVtAx69sH8Xzn27",
    highlights: ["siglo XVI", "altares completamente bañados en oro", "mayoría de los turistas nunca lo pisa"],
  },
  {
    img: "/home/imperdibles/ZONA-ARQUEOLOGICA.webp",
    nombre: "Zona Arqueológica",
    descripcion: "Bajo tus pies hay una pirámide más grande que la de Giza — no en altura, sino en volumen: la más grande jamás construida en el mundo. Recorre sus túneles excavados y sube 149 escalones hasta la iglesia que corona la cima.",
    categoria: "Arqueología",
    categoryEmoji: "🏛️",
    mapUrl: "https://maps.app.goo.gl/JxNqVGLRnmivHBUf7",
    highlights: ["más grande que la de Giza", "más grande jamás construida en el mundo", "túneles excavados"],
  },
  {
    img: "/home/imperdibles/SANTUARIO-DE-LA-VIRGEN-DE-LOS-REMEDIOS.webp",
    nombre: "Santuario de la Virgen de los Remedios",
    descripcion: "149 escalones te separan de la mejor vista de Cholula. Arriba te espera un templo construido literalmente encima de una pirámide, con el Popocatépetl humeando de fondo — la postal más icónica de la ciudad.",
    categoria: "Templo",
    categoryEmoji: "⛪",
    mapUrl: "https://maps.app.goo.gl/8vPuJBFNiYY7BFQZ7",
    highlights: ["149 escalones", "encima de una pirámide", "Popocatépetl humeando", "postal más icónica"],
  },
  {
    img: "/home/imperdibles/PARROQUIA-DE-SAN-PEDRO.webp",
    nombre: "Parroquia de San Pedro",
    descripcion: "Búscala en el horizonte: su torre es la más alta de todos los templos de Cholula, e ilumina las noches como el verdadero corazón religioso del centro.",
    categoria: "Templo",
    categoryEmoji: "⛪",
    mapUrl: "https://maps.app.goo.gl/oBXvUGmDDLBXJCuV9",
    highlights: ["la más alta de todos los templos", "corazón religioso del centro"],
  },
  {
    img: "/home/imperdibles/PORTAL-GUERRERO.webp",
    nombre: "Portal Guerrero",
    descripcion: "46 arcos, 170 metros, el portal más largo de toda Latinoamérica — y debajo de cada arco, un restaurante o cafetería distinta esperando que te sientes.",
    categoria: "Arquitectura",
    categoryEmoji: "🏛️",
    mapUrl: "https://maps.app.goo.gl/BLV4mVK37xfFuHkQ9",
    highlights: ["46 arcos", "170 metros", "más largo de toda Latinoamérica"],
  },
  {
    img: "/home/imperdibles/IGLESIA-DE-SANTIAGO.webp",
    nombre: "Iglesia de Santiago Mixquitla",
    descripcion: "Más de 400 años de historia gótica escondidos en un barrio que casi nadie visita. Su fachada esconde en piedra la figura de Santiago Peregrino y Guerrero — búscala tú mismo.",
    categoria: "Templo",
    categoryEmoji: "⛪",
    mapUrl: "https://maps.app.goo.gl/XkGXhA74DJe7nJ3U8",
    highlights: ["400 años", "historia gótica", "casi nadie visita"],
  },
  {
    img: "/home/imperdibles/MUSEO CASA CABALLERO AGUILA - MIKE SANTANA.webp",
    nombre: "Museo Casa del Caballero Águila",
    descripcion: "Toma la misma foto que María Félix en el balcón donde se filmó \"Enamorada\" — y descubre por qué esta casa de 400 años lleva el nombre de un guerrero azteca.",
    categoria: "Museo",
    categoryEmoji: "🦅",
    mapUrl: "https://maps.app.goo.gl/YNPpDpHxEfWDBZuQ8",
    highlights: ["María Félix", "\"Enamorada\"", "400 años", "guerrero azteca"],
  },
  {
    img: "/home/imperdibles/PARQUE-SORIA.webp",
    nombre: "Parque Soria",
    descripcion: "Voladores lanzándose desde lo alto, artesanías por todos lados, y la foto obligada en las letras de \"San Pedro Cholula\" — con la pirámide y su iglesia como telón de fondo.",
    categoria: "Parque",
    categoryEmoji: "🎪",
    mapUrl: "https://maps.app.goo.gl/2Vn7eR4YKTmJPiWs5",
    highlights: ["Voladores", "artesanías", "pirámide y su iglesia"],
  },
];

// Eventos
const eventos = ["/eventos/payasos-1024x1024-1.webp"];

// Galería Cholula corazón de México
const galeria = [
  {
    img: "/home/WhatsApp-Image-2025-07-04-at-20.47.49-1-scaled.webp",
    label: "Cholula Corazón de México",
  },
  {
    img: "/home/WhatsApp-Image-2025-07-04-at-20.47.49-2-scaled.webp",
    label: "Cholula Corazón de México",
  },
  {
    img: "/home/WhatsApp-Image-2025-07-04-at-20.47.49.webp",
    label: "Cholula Corazón de México",
  },
  {
    img: "/home/WhatsApp-Image-2025-07-04-at-20.47.49-3-scaled.webp",
    label: "Cholula Corazón de México",
  },
];

// Visítanos – categorías
const visitanos = [
  {
    href: "/donde-hospedarse",
    title: "Hoteles",
    img: "/home/visitanos/Hoteles - Foto_ Hotel Tila.webp",
    icons: ["🐾", "🏊"],
  },
  {
    href: "/donde-comer",
    title: "Restaurantes · Bares",
    img: "/home/visitanos/Restaurantes opción 1 Foto_ Ciudad Sagrada.webp",
    icons: ["🐾", "🎵"],
  },
  {
    href: "/que-hacer",
    title: "Experiencias",
    img: "/home/visitanos/Experiencias Foto_ Mike Santana.webp",
    icons: ["🚲", "🏛️"],
  },
  {
    href: "/guias-turisticos",
    title: "Guías certificados",
    img: "/home/visitanos/Guías turísticos Foto_ Mike Santana.webp",
    icons: ["🪪", "🗣️"],
  },
];

// Artesanías – mercados
const artesanias = [
  {
    href: "https://www.google.com/maps/place/Parque+Soria",
    label: "Parque Soria",
    img: "/home/Artesanias-Parque-Soria_cholula.webp",
    color: "var(--color-primary)",
    target: "_blank",
  },
  {
    href: "https://www.google.com/maps/place/Centro+San+Pedro+Cholula",
    label: "Zona Centro",
    img: "/home/Artesanias-Zona-Centro.jpg.webp",
    color: "var(--color-accent)",
    target: "_blank",
  },
];

import cholulaData from "../data/cholula.json";

// Items para la barra de búsqueda (Hoteles, Restaurantes, Qué hacer, Guías)
const searchItems = [
  ...(cholulaData.hoteles || []).map((item: any, i) => {
    const estrellasText = item.estrellas ? `${item.estrellas} estrellas` : "";
    return {
      id: i,
      label: item.nombre,
      category: "Hotel",
      href: "/donde-hospedarse",
      sublabel: "",
      searchKeywords: [
        estrellasText,
        item.zona,
        item.distanciaGranPiramide,
        item.categoriaPrecio,
        item.aceptaMascotas,
        item.tieneAlberca,
        item.tieneSpa,
        item.terraza,
        item.recepcion24h,
        item.categoria,
        item.amenidades,
        item.tamanioCategoria,
        item.perfilIdeal,
      ]
        .filter(Boolean)
        .join(" "),
      rating: item.estrellas || 0,
      horario: item.horario,
    };
  }),
  ...(cholulaData.restaurantes || []).map((item: any, i) => ({
    id: i,
    label: item.nombre,
    category: "Restaurante",
    href: "/donde-comer",
    sublabel: [item.tipoComida, item.ambiente, item.caracteristicasEspeciales]
      .filter(Boolean)
      .join(" • "),
    searchKeywords: [
      item.clasificacion,
      item.dondeEsta,
      item.tipoComida,
      item.ambiente,
      item.caracteristicasEspeciales,
      item.idealPara,
      item.horario?.detalle,
      item.zona,
      item.categoriaPrecio,
      item.petFriendly,
      item.musicaEnVivo,
      item.precioPpMxn,
      item.ocasionIdeal,
      item.perfilIdeal,
      item.etiquetasChatbot,
      item.espacioFisico,
    ]
      .filter(Boolean)
      .join(" "),
    horario: item.horario,
  })),
  ...(cholulaData.queHacer || []).map((item: any, i) => ({
    id: i,
    label: item.nombre,
    category: "Destino",
    href: "/que-hacer",
    sublabel: item.tipo || "",
    horario: item.horario,
  })),
  ...(cholulaData.guiasTuristicos || []).map((item: any, i) => ({
    id: i,
    label: item.nombre,
    category: "Guia",
    href: "/guias-turisticos",
    sublabel: item.paginaFacebook || "",
    horario: item.horario,
  })),
];

// ── JSON-LD Schemas ─────────────────────────────────────────────────────────
const touristDestinationSchema = {
  "@context": "https://schema.org",
  "@type": "TouristDestination",
  "name": "San Pedro Cholula",
  "alternateName": ["Cholula", "Visit Cholula", "Cholula Pueblo Mágico"],
  "description": "Cholula es la ciudad viva más antigua de América, habitada sin pausa desde el año 500 a.C. Posee la base de pirámide más grande del mundo, más de 365 iglesias y una vibrante escena gastronómica y hotelera.",
  "url": "https://visitcholula.mx",
  "image": "https://visitcholula.mx/hero-poster.webp",
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": 19.0547,
    "longitude": -98.3018
  },
  "containedInPlace": {
    "@type": "State",
    "name": "Puebla",
    "containedInPlace": {
      "@type": "Country",
      "name": "México"
    }
  },
  "touristType": ["Turistas culturales", "Turistas gastronómicos", "Familias", "Mochileros"],
  "hasMap": "https://www.google.com/maps/place/San+Pedro+Cholula,+Pue."
};

const webSiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": "Visit Cholula",
  "url": "https://visitcholula.mx",
  "description": "Guía turística oficial de San Pedro Cholula, Pueblo Mágico de Puebla, México.",
  "inLanguage": "es-MX",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://visitcholula.mx/?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const organizationSchema = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Visit Cholula",
  "url": "https://visitcholula.mx",
  "logo": "https://visitcholula.mx/logo_guia_cholula_2025.webp",
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": "+52-222-102-9059",
    "contactType": "tourist information",
    "availableLanguage": "Spanish"
  },
  "areaServed": {
    "@type": "City",
    "name": "San Pedro Cholula"
  }
};
---

<Layout
  title="Inicio — San Pedro Cholula, Pueblo Mágico"
  description="Descubre Cholula, la ciudad más antigua de América. Hoteles, restaurantes, guías turísticos certificados y todo lo que necesitas para visitar San Pedro Cholula, Pueblo Mágico de Puebla."
  canonical="/"
  jsonLd={[touristDestinationSchema, webSiteSchema, organizationSchema]}
>
  <!-- ══════════════════════════════
       HERO — Video cover full screen
       ══════════════════════════════ -->
  <section class="hero" id="hero">
    <video
      class="hero-video"
      poster="/hero-poster.webp"
      muted
      loop
      playsinline
      preload="none"
      aria-hidden="true"
    >
      <source data-src="/video.mp4" type="video/mp4" />
    </video>
    <div class="hero-overlay" aria-hidden="true"></div>

    <div class="hero-content">
      <!-- El contenido del hero original si hubiera título, si no, se queda vacío o se puede omitir -->
    </div>
  </section>

  <!-- ══════════════════════════════
       SEARCH SECTION (Nueva)
       ══════════════════════════════ -->
  <section class="section-search">
    <div class="container search-section-container">
      <h2 class="search-title">¿Qué te gustaría vivir hoy?</h2>
      <p class="search-subtitle">
        Cuéntanos qué buscas y te lo mostramos al instante
      </p>

      <div class="search-wrapper">
        <SearchBar
          client:idle
          items={searchItems}
          placeholder="¿Qué te gustaría hacer hoy en San Pedro Cholula?"
        />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════
       BIENVENIDO A CHOLULA
       ══════════════════════════════ -->
  <section class="section-bienvenido" id="bienvenido">
    <div class="container bienvenido-container">
      <div class="bienvenido-kicker">San Pedro Cholula, Puebla</div>
      <div class="bienvenido-lead">
        Imagina una ciudad donde una iglesia del siglo XVI fue construida encima
        de la pirámide más grande del mundo.
      </div>
    </div>

    <!-- Pirámide Mamona -->
    <div class="piramide-wrapper container">
      <section
        class="section-piramide"
        style="background-image: url('/home/piramide_mamona.webp');"
      >
        <div class="piramide-overlay"></div>
        <div class="piramide-content">
          <h2 class="piramide-title">
            Tenemos la pirámide con la base <span
              class="piramide-title-highlight">más grande del mundo</span
            >
          </h2>
          <p class="piramide-subtitle">
            Una iglesia en la cima, una pirámide bajo tus pies y el Popocatépetl
            de testigo.
          </p>
          <div class="piramide-actions">
            <a href="#itinerarios" class="piramide-btn-primary"
              >Planea tu visita</a
            >
            <a href="#imperdibles" class="piramide-btn-secondary"
              >Ver los imperdibles →</a
            >
          </div>
        </div>
      </section>
      <div class="piramide-foto-credito">Foto: Mike Santana</div>
    </div>

    <div class="container bienvenido-stats-container">
      <div class="bienvenido-stats">
        <div class="bienvenido-stat">
          <div class="bienvenido-stat-num">
            2,500<span class="bienvenido-stat-unit"> años</span>
          </div>
          <div class="bienvenido-stat-title">
            La ciudad viva más antigua del continente
          </div>
          <div class="bienvenido-stat-desc">
            Habitada sin parar desde el 500 a.C. — <strong
              >nunca abandonada</strong
            >
          </div>
        </div>
        <div class="bienvenido-stat">
          <div class="bienvenido-stat-num">+1M</div>
          <div class="bienvenido-stat-title">Visitantes al año</div>
          <div class="bienvenido-stat-desc">
            El Pueblo Mágico más visitado de Puebla — según DATATUR 2025
          </div>
        </div>
        <div class="bienvenido-stat">
          <div class="bienvenido-stat-num">
            500<span class="bienvenido-stat-unit"> años</span>
          </div>
          <div class="bienvenido-stat-title">
            El trueque más antiguo de América
          </div>
          <div class="bienvenido-stat-desc">
            <strong>Patrimonio Cultural Intangible de Puebla</strong> — cada septiembre,
            miles llegan a intercambiar artesanías y cosechas sin un peso de por medio
          </div>
        </div>
      </div>
    </div>

    </div>
  </section>

  <!-- ══════════════════════════════
       LOS IMPERDIBLES — Carrusel editorial
       ══════════════════════════════ -->
  <ImperdiblesCarousel items={imperdibles} />

  <!-- ══════════════════════════════
       ITINERARIOS
       ══════════════════════════════ -->
  <section
    class="section-itinerarios"
    id="itinerarios"
    style="padding: 4.5rem 0; background-color: #f9f9f9;"
  >
    <div class="container">
      <h2 class="section-label section-label--coral">INSPÍRATE</h2>
    </div>

    <div style="margin-top: 3rem;">
      <ItinerarioTabs itinerarios={itinerarioData.itinerarios} />
    </div>
  </section>

  <!-- ══════════════════════════════
       MAPA + CROQUIS
       ══════════════════════════════ -->
  <section class="section-mapa" id="mapa">
    <div class="container mapa-grid">
      <div class="mapa-embed">
        <iframe
          src="https://www.google.com/maps/d/embed?mid=1y8P9LnOP4uYJdVrJxk3YZyxxSxrpdcM&ehbc=2E312F"
          width="100%"
          height="100%"
          loading="lazy"
          title="Mapa de Cholula"></iframe>
      </div>
      <div class="mapa-croquis">
        <img
          src="/home/CROQUIS_MOVIL.webp"
          alt="Croquis turístico de Cholula"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- ══════════════════════════════
       EVENTOS — Carrusel 2 columnas
       ══════════════════════════════ -->
  <section class="section-eventos" id="eventos">
    <div class="container">
      <h2 class="section-label section-label--turquesa">EVENTOS</h2>
    </div>
    <SwiperGallery
      id="eventos"
      items={eventos.map((e) => ({ img: e }))}
      isEvento={true}
    />
  </section>

  <!-- ══════════════════════════════
       VISÍTANOS — Categorías
       ══════════════════════════════ -->
  <section class="section-visitanos" id="visitanos">
    <div class="container">
      <h2 class="section-label section-label--coral">VISÍTANOS</h2>
    </div>
    <div class="visitanos-grid">
      {
        visitanos.map((v) => (
          <VisitanosCard
            href={v.href}
            title={v.title}
            img={v.img}
            icons={v.icons}
          />
        ))
      }
    </div>
  </section>
  <!-- ══════════════════════════════
       ARTESANÍAS
       ══════════════════════════════ -->
  <section class="section-artesanias" id="artesanias">
    <div class="container">
      <h2 class="section-label section-label--coral">ARTESANÍAS</h2>
    </div>
    <div class="artesanias-grid">
      {
        artesanias.map((a) => (
          <ImageCard
            href={a.href}
            img={a.img!}
            label={a.label}
            color={a.color!}
            target={a.target}
          />
        ))
      }
    </div>
  </section>
</Layout>
