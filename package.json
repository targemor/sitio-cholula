{
  "name": "astro-frontend",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "extract": "node scripts/extract-wp-data.cjs && node scripts/normalize-booleans.cjs",
    "normalize-data": "node scripts/normalize-booleans.cjs",
    "convert-images": "node scripts/convert-to-webp.js",
    "dev": "astro dev",
    "build": "astro build && node scripts/purge-css.cjs",
    "build:nopurge": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lighthouse": "npx lighthouse https://visit-cholula.vercel.app/ --view --output html --output-path ./lighthouse-report.html",
    "lighthouse:parse": "node ./scripts/extract-lh-feedback.js"
  },
  "dependencies": {
    "@astrojs/react": "^5.0.7",
    "@astrojs/sitemap": "^3.7.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "astro": "^6.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "swiper": "^12.2.0"
  },
  "devDependencies": {
    "purgecss": "^8.0.0",
    "sharp": "^0.33.5"
  }
}